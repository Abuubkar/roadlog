# Copy to .env and adjust. All values are optional for local development.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins allowed to call the API (the GitHub Pages site in production).
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Identify yourself to the public OSM services (their usage policies require it).
GEO_USER_AGENT=RoadLog/1.0 (you@example.com)
